{
  "schemaVersion": 1,
  "id": "skinmc_mod",
  "version": "${version}",
  "name": "SkinMC Mod",
  "description": "Wear your custom SkinMC cape in-game. Your style, your cape.",
  "authors": [
    "Rux"
  ],
  "contact": {
    "homepage": "https://skinmc.net/",
    "sources": "https://github.com/SkinMC/",
    "issues": "https://github.com/SkinMC/issues"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/skinmc_mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.skinmc.fabric.SkinMCModFabric"
    ],
    "client": [
      "net.skinmc.fabric.client.SkinMCModFabricClient"
    ],
    "modmenu": [
      "net.skinmc.fabric.client.SkinMCModMenuApi"
    ]
  },
  "mixins": [
    "skinmc_mod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "architectury": ">=21.0.7",
    "fabric-api": ">=0.158.0"
  },
  "suggests": {
    "modmenu": ">=20.0.1"
  }
}
